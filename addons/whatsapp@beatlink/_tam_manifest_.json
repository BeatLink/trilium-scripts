{
    "id": "whatsapp@beatlink",
    "name": "WhatsApp",
    "description": "WhatsApp Web inside Trilium Desktop, as a Web View note with a launchbar button. WhatsApp turns away Trilium's default Electron user agent, so the addon overrides the user agent of any Web View note pointed at web.whatsapp.com - with the plain Chrome string of Trilium's own Chromium build by default, or any user agent you set on the settings page.",
    "author": "BeatLink",
    "homepage": "https://github.com/BeatLink/trilium-scripts/tree/main/addons/whatsapp@beatlink",
    "license": "GPL-3.0-or-later",
    "latestVersion": "1.1.0",
    "type": "script",
    "readme": "README.md",
    "manifestSourceUrl": "https://beatlink.github.io/trilium-scripts/whatsapp@beatlink/_tam_manifest_.json",
