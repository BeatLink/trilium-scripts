{
    "searchProviders": {
        "duckduckgo": {
            "name": "DuckDuckGo",
            "urlTemplate": "https://duckduckgo.com/?q=%s"
        },
        "google": {
            "name": "Google",
            "urlTemplate": "https://www.google.com/search?q=%s"
        },
        "wikipedia": {
            "name": "Wikipedia",
            "urlTemplate": "https://en.wikipedia.org/w/index.php?search=%s"
        },
        "youtube": {
            "name": "YouTube",
            "urlTemplate": "https://www.youtube.com/results?search_query=%s"
        }
    },
    "defaultProvider": "duckduckgo",
    "bookmarks": {},
    "bookmarkLayout": "grid",
    "newTabParent": "current",
    "newTabParentNoteId": "",
    "interceptAllLinks": false,
    "linkPlacement": "child",
    "followPageUrl": true,
    "rememberHistory": true,
    "showSaveButton": false,
    "saveParentNoteId": "",
    "syncNoteTitle": true,
    "reuseExistingNotes": true,
    "userAgentMode": "default",
    "userAgent": "",
    "sponsorBlockEnabled": true,
    "sponsorBlockNotify": true,
    "skipSponsor": true,
    "skipSelfPromo": true,
    "skipInteraction": true,
    "skipIntro": false,
    "skipOutro": false,
    "skipPreview": false,
    "skipMusicOfftopic": false,
    "skipFiller": false
}
