{
    "id": "webview-keepassxc@beatlink",
    "name": "Web View KeePassXC",
    "description": "Fills logins from KeePassXC into Trilium Desktop's built-in Web View note type. Speaks the same encrypted browser protocol keepassxc-browser speaks, straight to KeePassXC's local socket, then injects an entry picker into the page and fills the username, password and one-time code of whichever entry you choose.",
    "author": "BeatLink",
    "homepage": "https://github.com/BeatLink/trilium-scripts/tree/main/addons/webview-keepassxc@beatlink",
    "license": "GPL-3.0-or-later",
    "latestVersion": "1.0.1",
    "type": "script",
    "readme": "README.md",
