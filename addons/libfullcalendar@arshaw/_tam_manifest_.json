{
    "id": "libfullcalendar@arshaw",
    "name": "FullCalendar",
    "description": "Vendored FullCalendar (standard bundle + iCalendar plugin) — a browser calendar UI library, bundled as static resources for TriliumNext widgets to load as script tags.",
    "author": "arshaw",
    "homepage": "https://github.com/BeatLink/trilium-scripts/tree/main/addons/libfullcalendar@arshaw",
    "license": "MIT",
    "latestVersion": "1.0.0",
    "type": "library",
    "readme": "README.md",
    "manifest": {
        "root": "core",
        "notes": [
            {"id": "core",    "title": "fullcalendar.global.min.js",            "type": "code", "mime": "application/javascript;env=frontend", "sourceUrl": "fullcalendar.global.min.js"},
            {"id": "icalendar", "title": "fullcalendar-icalendar.global.min.js", "type": "code", "mime": "application/javascript;env=frontend", "sourceUrl": "fullcalendar-icalendar.global.min.js"}
        ],
        "children": [
            {"parent": "core", "child": "icalendar"}
        ],
        "relations": [],
        "labels": [
            {"note": "core",      "name": "customResourceProvider", "value": "libFullCalendar.js"},
            {"note": "icalendar", "name": "customResourceProvider", "value": "libFullCalendarICalendar.js"}
        ],
        "dependencies": [],
        "exports": {}
    }
}
