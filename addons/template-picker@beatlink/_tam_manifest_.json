{
    "id": "template-picker@beatlink",
    "name": "Template Picker",
    "description": "A right-pane widget for assigning or changing the template of the currently active note, plus a Missing Templates page that triages every note still lacking one, and configurable search-based filters to exclude specific notes from the picker. Ships eight bundled template notes under its own persisted Templates container: seven item types (Ideas / Goal / Routine / Task / Future / Project / Note) and, as of 1.6.0, the AreaCollection container template that agenda-structure@beatlink used to ship - agenda-structure still instantiates it, resolving it live by title, so moving it here means the picker owns every bundled template in one place. Existing agenda-structure installs must run migrate-areacollection-from-structure.js once before updating either addon.",
    "author": "BeatLink",
    "homepage": "https://github.com/BeatLink/trilium-scripts/tree/main/addons/template-picker@beatlink",
    "license": "GPL-3.0-or-later",
    "latestVersion": "1.8.0",
    "type": "widget",
    "readme": "README.md",
