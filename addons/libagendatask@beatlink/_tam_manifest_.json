    "type": "library",
    "readme": "README.md",
    "manifestSourceUrl": "https://raw.githubusercontent.com/BeatLink/trilium-scripts/refs/heads/main/addons/libagendatask@beatlink/_tam_manifest_.json",
    "manifest": {
