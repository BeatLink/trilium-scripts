{
    "id": "priority-widget@beatlink",
    "name": "Priority Widget",
    "description": "A widget to set the priority of a note",
    "author": "BeatLink",
    "homepage": "https://github.com/BeatLink/trilium-scripts/tree/main/addons/priority-widget@beatlink",
    "license": "GPL-3.0-or-later",
    "latestVersion": "1.0.1",
    "type": "widget",
    "readme": "README.md",
    "manifest": {
        "root": "root",
        "notes": [
            {
                "id": "root",
                "title": "priority-widget@beatlink",
                "type": "code",
                "mime": "text/jsx",
                "sourceUrl": "priority-widget@beatlink.jsx"
            },
            {
                "id": "style",
                "title": "style.css",
                "type": "code",
                "mime": "text/css",
                "sourceUrl": "style.css"
            },
            {
                "id": "profile",
                "title": "profile.json",
                "type": "code",
                "mime": "application/json",
                "sourceUrl": "profile.json"
            }
        ],
        "children": [
            {
                "parent": "root",
                "child": "style"
            },
            {
                "parent": "root",
                "child": "profile"
            }
        ],
        "relations": [
            {
                "from": "root",
                "type": "AddonData:profile",
                "to": "profile"
            }
        ],
        "labels": [
            {
                "note": "root",
                "name": "widget",
                "value": ""
            },
            {
                "note": "style",
                "name": "appCss",
                "value": ""
            }
        ],
        "dependencies": [],
        "exports": {}
    }
}
