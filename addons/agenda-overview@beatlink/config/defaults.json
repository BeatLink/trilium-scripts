    "dateRules": {
        "noDate": {
            "name": "No Date",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isNull"
        },
        "overdue": {
            "name": "Overdue",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBefore",
            "moment1": "startOfToday"
        },
        "now": {
            "name": "Now",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "startOfToday",
            "moment2": "now",
            "bracket": "[]"
        },
        "restOfDay": {
            "name": "Later Today",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "now",
            "moment2": "endOfToday",
            "bracket": "[]"
        },
        "tomorrow": {
            "name": "Tomorrow",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "endOfToday",
            "moment2": "endOfTomorrow",
            "bracket": "[]"
        },
        "thisWeek": {
            "name": "This Week",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "endOfToday",
            "moment2": "endOfThisWeek",
            "bracket": "[)"
        },
        "thisMonth": {
            "name": "This Month",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "endOfThisWeek",
            "moment2": "endOfThisMonth",
            "bracket": "[)"
        },
        "thisYear": {
            "name": "This Year",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isBetween",
            "moment1": "endOfThisMonth",
            "moment2": "endOfThisYear",
            "bracket": "[]"
        },
        "future": {
            "name": "Future",
            "dateLabel": "startDateTime",
            "useNumberOfDays": false,
            "operator": "isAfter",
            "moment1": "endOfThisYear"
        }
    }
