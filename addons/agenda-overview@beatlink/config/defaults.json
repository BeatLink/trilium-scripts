    "searchGroups": {
        "type": {
            "name": "Note Type",
            "profileId": "default",
            "children": {
                "all": {
                    "name": "All Tasks",
                    "rule": "(#startDateTime != \"\" OR #dueDateTime != \"\") AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": false
                },
                "goal": {
                    "name": "1. Goal",
                    "rule": "~template.title='1. Goal' AND not(note.parents.relations.template.title='1. Goal') AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": true
                },
                "routine": {
                    "name": "2. Routines",
                    "rule": "~template.title='2. Routine' AND not(note.parents.relations.template.title='2. Routine') AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": true
                },
                "tasks": {
                    "name": "3. Tasks",
                    "rule": "~template.title='3. Task' AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": true
                },
                "future": {
                    "name": "4. Future",
                    "rule": "~template.title='4. Future' AND not(note.parents.relations.template.title='4. Future') AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": true
                },
                "project": {
                    "name": "5. Projects",
                    "rule": "~template.title='5. Project' AND not(note.parents.relations.template.title='5. Project') AND not(note.parents.relations.template.title='3. Task')",
                    "enabled": true
                }
            }
        },
        "leaf": {
            "name": "Leaf Tasks",
            "profileId": "default",
            "children": {
                "leafTasks": {
                    "name": "Leaf Subtasks",
                    "rule": "~template.title='3. Task' AND note.ancestors.relations.template.title='3. Task' AND not(note.children.relations.template.title='3. Task')",
                    "enabled": false
                },
                "leafTasksAnyDepth": {
                    "name": "Leaf Tasks (Any Depth)",
                    "rule": "~template.title='3. Task' AND not(note.children.relations.template.title='3. Task')",
                    "enabled": false
                }
            }
        }
    },
