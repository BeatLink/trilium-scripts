{
    "id": "expanded@beatlink",
    "name": "Expanded",
    "description": "Keep selected notes always expanded in the note tree. Toggle 'Always Expanded' from the right pane header on any note to pin it open permanently, even after restarting Trilium. The label used to mark a note is configurable in settings.",
