                "name": "Interval", "type": "dayjs",
                "intervals": {
                    "overdue": { "dateRuleId": "overdue", "color": "red" },
                    "now": { "dateRuleId": "now", "color": "lime" },
                    "restOfDay": { "dateRuleId": "restOfDay", "color": "cyan" },
                    "tomorrow": { "dateRuleId": "tomorrow", "color": "gray" },
                    "thisWeek": { "dateRuleId": "thisWeek", "color": "lightgray" },
                    "thisMonth": { "dateRuleId": "thisMonth", "color": "lightgray" },
                    "thisYear": { "dateRuleId": "thisYear", "color": "lightgray" },
                    "future": { "dateRuleId": "future", "color": "lightgray" }
                }
            }
        }
    },
    "dateRules": {
        "type": "registry",
        "label": "Date Rules",
        "tab": "Date Rules",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Date Rule" },
            "dateLabel": { "type": "string", "label": "Date Label", "default": "" },
            "useNumberOfDays": { "type": "boolean", "label": "Use Number of Days", "default": false },
            "operator": {
                "type": "select", "label": "Operator", "default": "isNull",
                "options": [
                    { "value": "isNull", "label": "isNull" },
                    { "value": "isBefore", "label": "isBefore" },
                    { "value": "isAfter", "label": "isAfter" },
                    { "value": "isBetween", "label": "isBetween" }
                ]
            },
            "moment1": {
                "type": "select", "label": "Moment 1", "default": "now", "showWhen": { "operator": ["isBefore", "isAfter", "isBetween"] },
                "options": [
                    { "value": "now", "label": "now" },
                    { "value": "startOfToday", "label": "startOfToday" },
                    { "value": "endOfToday", "label": "endOfToday" },
                    { "value": "endOfTomorrow", "label": "endOfTomorrow" },
                    { "value": "endOfThisWeek", "label": "endOfThisWeek" },
                    { "value": "endOfThisMonth", "label": "endOfThisMonth" },
                    { "value": "endOfThisYear", "label": "endOfThisYear" }
                ]
            },
            "moment2": {
                "type": "select", "label": "Moment 2", "default": "now", "showWhen": { "operator": "isBetween" },
                "options": [
                    { "value": "now", "label": "now" },
                    { "value": "startOfToday", "label": "startOfToday" },
                    { "value": "endOfToday", "label": "endOfToday" },
                    { "value": "endOfTomorrow", "label": "endOfTomorrow" },
                    { "value": "endOfThisWeek", "label": "endOfThisWeek" },
                    { "value": "endOfThisMonth", "label": "endOfThisMonth" },
                    { "value": "endOfThisYear", "label": "endOfThisYear" }
                ]
            },
            "bracket": {
                "type": "select", "label": "Bracket", "default": "[]", "showWhen": { "operator": "isBetween" },
                "options": [
                    { "value": "[]", "label": "[]" },
                    { "value": "[)", "label": "[)" },
                    { "value": "(]", "label": "(]" },
                    { "value": "()", "label": "()" }
                ]
            }
        },
        "default": {
            "noDate": { "name": "No Date", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isNull" },
            "overdue": { "name": "Overdue", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBefore", "moment1": "startOfToday" },
            "now": { "name": "Now", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "startOfToday", "moment2": "now", "bracket": "[]" },
            "restOfDay": { "name": "Later Today", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "now", "moment2": "endOfToday", "bracket": "[]" },
            "tomorrow": { "name": "Tomorrow", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "endOfToday", "moment2": "endOfTomorrow", "bracket": "[]" },
            "thisWeek": { "name": "This Week", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "endOfToday", "moment2": "endOfThisWeek", "bracket": "[)" },
            "thisMonth": { "name": "This Month", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "endOfThisWeek", "moment2": "endOfThisMonth", "bracket": "[)" },
            "thisYear": { "name": "This Year", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isBetween", "moment1": "endOfThisMonth", "moment2": "endOfThisYear", "bracket": "[]" },
            "future": { "name": "Future", "dateLabel": "startDateTime", "useNumberOfDays": false, "operator": "isAfter", "moment1": "endOfThisYear" }
        }
    }
}
