    "profiles": {
        "type": "registry",
        "label": "Profiles",
        "tab": "Profiles",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Profile" },
            "parentNoteId": { "type": "note", "label": "File Tasks Under", "default": "" },
            "sortSelected": { "type": "reference", "label": "Sort", "registry": "sorts", "default": "" },
            "prefixSelected": { "type": "reference", "label": "Prefix", "registry": "prefixes", "default": "" },
            "colorSelected": { "type": "reference", "label": "Color", "registry": "colors", "default": "" },
            "searchGroups": { "type": "checklist", "label": "Searches", "registry": "searchGroups", "filterBy": "profileId" },
            "filterGroups": { "type": "checklist", "label": "Filters", "registry": "filterGroups", "filterBy": "profileId" }
        },
        "default": {
            "default": {
                "name": "default",
                "parentNoteId": "",
                "sortSelected": "startDate",
                "prefixSelected": "interval",
                "colorSelected": "priority"
            }
        }
    },
    "searchGroups": {
        "type": "registry",
        "label": "Search Groups",
        "tab": "Searches",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Group" },
            "profileId": { "type": "reference", "label": "Profile", "registry": "profiles", "default": "" },
            "children": {
                "type": "registry",
                "label": "Searches",
                "default": {},
                "itemSchema": {
                    "name": { "type": "string", "label": "Name", "default": "New Search" },
                    "rule": { "type": "string", "label": "Search Rule", "default": "" },
                    "enabled": { "type": "boolean", "label": "Enabled", "default": true }
                }
            }
        },
        "default": {
            "type": {
                "name": "Note Type",
                "profileId": "default",
                "children": {
                    "all": { "name": "All Tasks", "rule": "#startDateTime", "enabled": false },
                    "calendar": { "name": "1. High Priority", "rule": "~template.title='1. High Priority' AND not(note.parents.relations.template.title='1. High Priority')", "enabled": true },
                    "routine": { "name": "2. Routines", "rule": "~template.title='2. Routine' AND not(note.parents.relations.template.title='2. Routine')", "enabled": true },
                    "tasks": { "name": "3. Tasks", "rule": "~template.title='3. Task' AND #dueDateTime", "enabled": true },
                    "future": { "name": "4. Future", "rule": "~template.title='4. Future' AND not(note.parents.relations.template.title='4. Future')", "enabled": true }
                }
            }
        }
    },
    "filterGroups": {
        "type": "registry",
        "label": "Filter Groups",
        "tab": "Filters",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Filter Group" },
            "profileId": { "type": "reference", "label": "Profile", "registry": "profiles", "default": "" },
            "children": {
                "type": "registry",
                "label": "Filters",
                "default": {},
                "itemSchema": {
                    "name": { "type": "string", "label": "Name", "default": "New Filter" },
                    "type": {
                        "type": "select", "label": "Type", "default": "search",
                        "options": [
                            { "value": "search", "label": "Search Query" },
                            { "value": "dayjs", "label": "Date Comparison" }
                        ]
                    },
                    "rule": { "type": "string", "label": "Search Rule", "default": "", "showWhen": { "type": "search" } },
                    "dateRuleId": { "type": "reference", "label": "Date Rule", "registry": "dateRules", "default": "", "showWhen": { "type": "dayjs" } },
                    "enabled": { "type": "boolean", "label": "Enabled", "default": true }
                }
            }
        },
        "default": {
            "priority": {
                "name": "Priority",
                "profileId": "default",
                "children": {
                    "must": { "name": "Must Do", "type": "search", "rule": "#priority='4-critical'", "enabled": true },
                    "should": { "name": "Should Do", "type": "search", "rule": "#priority='3-high'", "enabled": true },
                    "could": { "name": "Could Do", "type": "search", "rule": "#priority='2-medium'", "enabled": true },
                    "want": { "name": "Want To Do", "type": "search", "rule": "#priority='1-low'", "enabled": true },
                    "none": { "name": "No Priority", "type": "search", "rule": "#!priority OR #priority=''", "enabled": false }
                }
            },
            "date": {
                "name": "Date",
                "profileId": "default",
                "children": {
                    "noDate": { "name": "No Date", "type": "dayjs", "dateRuleId": "noDate", "enabled": false },
                    "overdue": { "name": "Overdue", "type": "dayjs", "dateRuleId": "overdue", "enabled": true },
                    "now": { "name": "Now", "type": "dayjs", "dateRuleId": "now", "enabled": true },
                    "restOfDay": { "name": "Later Today", "type": "dayjs", "dateRuleId": "restOfDay", "enabled": true },
                    "tomorrow": { "name": "Tomorrow", "type": "dayjs", "dateRuleId": "tomorrow", "enabled": false },
                    "thisWeek": { "name": "This Week", "type": "dayjs", "dateRuleId": "thisWeek", "enabled": false },
                    "thisMonth": { "name": "This Month", "type": "dayjs", "dateRuleId": "thisMonth", "enabled": false },
                    "thisYear": { "name": "This Year", "type": "dayjs", "dateRuleId": "thisYear", "enabled": false },
                    "future": { "name": "Future", "type": "dayjs", "dateRuleId": "future", "enabled": false }
                }
            },
            "recurrence": {
                "name": "Recurrence",
                "profileId": "default",
                "children": {
                    "hourly": { "name": "Hourly", "type": "search", "rule": "#recurrence *=* HOURLY", "enabled": true },
                    "daily": { "name": "Daily", "type": "search", "rule": "#recurrence *=* DAILY", "enabled": true },
                    "weekly": { "name": "Weekly", "type": "search", "rule": "#recurrence *=* WEEKLY", "enabled": true },
                    "monthly": { "name": "Monthly", "type": "search", "rule": "#recurrence *=* MONTHLY", "enabled": true },
                    "yearly": { "name": "Yearly", "type": "search", "rule": "#recurrence *=* YEARLY", "enabled": true },
                    "noRecurrence": { "name": "No Recurrence", "type": "search", "rule": "#!recurrence OR (#recurrence='')", "enabled": true }
                }
            },
            "area": {
                "name": "Area",
                "profileId": "default",
                "children": {
                    "1-career": { "name": "Career", "type": "search", "rule": "#area='01-career'", "enabled": true },
                    "2-finances": { "name": "Finances", "type": "search", "rule": "#area='02-finances'", "enabled": true },
                    "3-home": { "name": "Home", "type": "search", "rule": "#area='03-home'", "enabled": true },
                    "4-car": { "name": "Car", "type": "search", "rule": "#area='04-car'", "enabled": true },
                    "5-fitness": { "name": "Fitness", "type": "search", "rule": "#area='05-fitness'", "enabled": true },
                    "6-grooming": { "name": "Grooming", "type": "search", "rule": "#area='06-grooming'", "enabled": true },
                    "7-sexual": { "name": "Sexual", "type": "search", "rule": "#area='07-sexual'", "enabled": true },
                    "8-social": { "name": "Social", "type": "search", "rule": "#area='08-social'", "enabled": true },
                    "9-health": { "name": "Health", "type": "search", "rule": "#area='09-health'", "enabled": true },
                    "10-mental": { "name": "Mental", "type": "search", "rule": "#area='10-mental'", "enabled": true },
                    "11-identity": { "name": "Identity", "type": "search", "rule": "#area='11-identity'", "enabled": true },
                    "12-productivity": { "name": "Productivity", "type": "search", "rule": "#area='12-productivity'", "enabled": true },
                    "13-tech": { "name": "Tech", "type": "search", "rule": "#area='13-tech'", "enabled": true },
                    "14-fun": { "name": "Fun", "type": "search", "rule": "#area='14-fun'", "enabled": true },
                    "15-none": { "name": "No Area", "type": "search", "rule": "#!area OR #area=''", "enabled": true }
                }
            }
        }
    },
    "sorts": {
        "type": "registry",
        "label": "Sorts",
        "tab": "Sorts",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Sort" },
            "criteria": {
                "type": "list",
                "label": "Criteria",
                "default": [],
                "itemSchema": {
                    "attribute": { "type": "string", "label": "Attribute", "default": "" },
                    "desc": { "type": "boolean", "label": "Descending", "default": false },
                    "caseInsensitive": { "type": "boolean", "label": "Case Insensitive", "default": false }
                }
            }
        },
        "default": {
            "startDate": { "name": "Start Date", "criteria": [
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "title": { "name": "Title", "criteria": [
                { "attribute": "title", "desc": false, "caseInsensitive": true }
            ] },
            "typePriorityStartDate": { "name": "Type → Priority → Start Date", "criteria": [
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "typeStartDate": { "name": "Type → Start Date", "criteria": [
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "area": { "name": "Area → Start Date", "criteria": [
                { "attribute": "area", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "priorityStartDate": { "name": "Priority → Start Date", "criteria": [
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "priorityTypeStartDate": { "name": "Priority → Type → Start Date", "criteria": [
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] }
        }
    },
    "prefixes": {
        "type": "registry",
        "label": "Prefixes",
        "tab": "Prefixes",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Prefix" },
            "type": {
                "type": "select", "label": "Type", "default": "label",
                "options": [
                    { "value": "label", "label": "By Label Value" },
                    { "value": "dayjs", "label": "By Date" }
                ]
            },
            "label": { "type": "string", "label": "Note Label", "default": "", "showWhen": { "type": "label" } },
            "children": {
                "type": "registry", "label": "Values", "default": {}, "showWhen": { "type": "label" },
                "itemSchema": {
                    "labelValue": { "type": "string", "label": "Label Value", "default": "" },
                    "display": { "type": "string", "label": "Prefix Text", "default": "" }
                }
            },
            "intervals": {
                "type": "registry", "label": "Intervals", "default": {}, "showWhen": { "type": "dayjs" },
                "itemSchema": {
                    "dateRuleId": { "type": "reference", "label": "Date Rule", "registry": "dateRules", "default": "" },
                    "formatString": { "type": "string", "label": "Format String", "default": "" }
                }
            }
        },
        "default": {
            "priority": {
                "name": "Priority", "type": "label", "label": "priority",
                "children": {
                    "4-critical": { "labelValue": "4-critical", "display": "Must Do" },
                    "3-high": { "labelValue": "3-high", "display": "Should Do" },
                    "2-medium": { "labelValue": "2-medium", "display": "Could Do" },
                    "1-low": { "labelValue": "1-low", "display": "Want to Do" }
                }
            },
            "area": {
                "name": "Area", "type": "label", "label": "area",
                "children": {
                    "01-career": { "labelValue": "01-career", "display": "Career" },
                    "02-finances": { "labelValue": "02-finances", "display": "Finances" },
                    "03-home": { "labelValue": "03-home", "display": "Home" },
                    "04-car": { "labelValue": "04-car", "display": "Car" },
                    "05-fitness": { "labelValue": "05-fitness", "display": "Fitness" },
                    "06-grooming": { "labelValue": "06-grooming", "display": "Grooming" },
                    "07-sexual": { "labelValue": "07-sexual", "display": "Sexual" },
                    "08-social": { "labelValue": "08-social", "display": "Social" },
                    "09-health": { "labelValue": "09-health", "display": "Health" },
                    "10-mental": { "labelValue": "10-mental", "display": "Mental" },
                    "11-identity": { "labelValue": "11-identity", "display": "Identity" },
                    "12-productivity": { "labelValue": "12-productivity", "display": "Productivity" },
                    "13-tech": { "labelValue": "13-tech", "display": "Tech" },
                    "14-fun": { "labelValue": "14-fun", "display": "Fun" }
                }
            },
            "interval": {
                "name": "Interval", "type": "dayjs",
                "intervals": {
                    "overdue": { "dateRuleId": "overdue", "formatString": "MMM D, YYYY HH:mm" },
                    "now": { "dateRuleId": "now", "formatString": "HH:mm" },
                    "restOfDay": { "dateRuleId": "restOfDay", "formatString": "HH:mm" },
                    "tomorrow": { "dateRuleId": "tomorrow", "formatString": "[Tmrw] HH:mm" },
                    "thisWeek": { "dateRuleId": "thisWeek", "formatString": "ddd" },
                    "thisMonth": { "dateRuleId": "thisMonth", "formatString": "Do" },
                    "thisYear": { "dateRuleId": "thisYear", "formatString": "MMMM" },
                    "future": { "dateRuleId": "future", "formatString": "YYYY" }
                }
            }
        }
    },
    "colors": {
        "type": "registry",
        "label": "Colors",
        "tab": "Colors",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Color" },
            "type": {
                "type": "select", "label": "Type", "default": "label",
                "options": [
                    { "value": "label", "label": "By Label Value" },
                    { "value": "dayjs", "label": "By Date" }
                ]
            },
            "label": { "type": "string", "label": "Note Label", "default": "", "showWhen": { "type": "label" } },
            "children": {
                "type": "registry", "label": "Values", "default": {}, "showWhen": { "type": "label" },
                "itemSchema": {
                    "labelValue": { "type": "string", "label": "Label Value", "default": "" },
                    "display": { "type": "color", "label": "Color", "default": "gray" }
                }
            },
            "intervals": {
                "type": "registry", "label": "Intervals", "default": {}, "showWhen": { "type": "dayjs" },
                "itemSchema": {
                    "dateRuleId": { "type": "reference", "label": "Date Rule", "registry": "dateRules", "default": "" },
                    "color": { "type": "color", "label": "Color", "default": "gray" }
                }
            }
        },
        "default": {
            "priority": {
                "name": "Priority", "type": "label", "label": "priority",
                "children": {
                    "4-critical": { "labelValue": "4-critical", "display": "red" },
                    "3-high": { "labelValue": "3-high", "display": "gold" },
                    "2-medium": { "labelValue": "2-medium", "display": "lime" },
                    "1-low": { "labelValue": "1-low", "display": "cyan" }
                }
            },
            "area": {
                "name": "Area", "type": "label", "label": "area",
                "children": {
                    "01-career": { "labelValue": "01-career", "display": "red" },
                    "02-finances": { "labelValue": "02-finances", "display": "red" },
                    "03-home": { "labelValue": "03-home", "display": "darkorange" },
                    "04-car": { "labelValue": "04-car", "display": "darkorange" },
                    "05-fitness": { "labelValue": "05-fitness", "display": "gold" },
                    "06-grooming": { "labelValue": "06-grooming", "display": "gold" },
                    "07-sexual": { "labelValue": "07-sexual", "display": "gold" },
                    "08-social": { "labelValue": "08-social", "display": "lime" },
                    "09-health": { "labelValue": "09-health", "display": "lime" },
                    "10-mental": { "labelValue": "10-mental", "display": "lime" },
                    "11-identity": { "labelValue": "11-identity", "display": "lime" },
                    "12-productivity": { "labelValue": "12-productivity", "display": "lime" },
                    "13-tech": { "labelValue": "13-tech", "display": "cyan" },
                    "14-fun": { "labelValue": "14-fun", "display": "magenta" }
                }
            },
