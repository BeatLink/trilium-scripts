{
    "searches": {
        "all": { "name": "All Tasks", "rule": "#startDateTime", "builtin": true },
        "calendar": { "name": "1. High Priority", "rule": "~template.title='1. High Priority' AND not(note.parents.relations.template.title='1. High Priority')", "builtin": true },
        "routine": { "name": "2. Routines", "rule": "~template.title='2. Routine' AND not(note.parents.relations.template.title='2. Routine')", "builtin": true },
        "tasks": { "name": "3. Tasks", "rule": "~template.title='3. Task' AND #dueDateTime", "builtin": true },
        "future": { "name": "4. Future", "rule": "~template.title='4. Future' AND not(note.parents.relations.template.title='4. Future')", "builtin": true }
    },
    "dateRules": {
        "noDate": { "name": "No Date", "rule": ["isNull"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "overdue": { "name": "Overdue", "rule": ["isBefore", "startOfToday"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "now": { "name": "Now", "rule": ["isBetween", "startOfToday", "now", null, "[]"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "restOfDay": { "name": "Later Today", "rule": ["isBetween", "now", "endOfToday", null, "[]"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "tomorrow": { "name": "Tomorrow", "rule": ["isBetween", "endOfToday", "endOfTomorrow", null, "[]"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "thisWeek": { "name": "This Week", "rule": ["isBetween", "endOfToday", "endOfThisWeek", null, "[)"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "thisMonth": { "name": "This Month", "rule": ["isBetween", "endOfThisWeek", "endOfThisMonth", null, "[)"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "thisYear": { "name": "This Year", "rule": ["isBetween", "endOfThisMonth", "endOfThisYear", null, "[]"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true },
        "future": { "name": "Future", "rule": ["isAfter", "endOfThisYear"], "dateLabel": "startDateTime", "useNumberOfDays": false, "builtin": true }
    },
    "filters": {
        "noDate": { "name": "No Date", "type": "dayjs", "dateRuleId": "noDate", "builtin": true },
        "overdue": { "name": "Overdue", "type": "dayjs", "dateRuleId": "overdue", "builtin": true },
        "now": { "name": "Now", "type": "dayjs", "dateRuleId": "now", "builtin": true },
        "restOfDay": { "name": "Later Today", "type": "dayjs", "dateRuleId": "restOfDay", "builtin": true },
        "tomorrow": { "name": "Tomorrow", "type": "dayjs", "dateRuleId": "tomorrow", "builtin": true },
        "thisWeek": { "name": "This Week", "type": "dayjs", "dateRuleId": "thisWeek", "builtin": true },
        "thisMonth": { "name": "This Month", "type": "dayjs", "dateRuleId": "thisMonth", "builtin": true },
        "thisYear": { "name": "This Year", "type": "dayjs", "dateRuleId": "thisYear", "builtin": true },
        "future": { "name": "Future", "type": "dayjs", "dateRuleId": "future", "builtin": true },
        "must": { "name": "Must Do", "type": "search", "rule": "#priority='4-critical'", "builtin": true },
        "should": { "name": "Should Do", "type": "search", "rule": "#priority='3-high'", "builtin": true },
        "could": { "name": "Could Do", "type": "search", "rule": "#priority='2-medium'", "builtin": true },
        "want": { "name": "Want To Do", "type": "search", "rule": "#priority='1-low'", "builtin": true },
        "none": { "name": "No Priority", "type": "search", "rule": "#!priority OR #priority=''", "builtin": true },
        "hourly": { "name": "Hourly", "type": "search", "rule": "#recurrence *=* HOURLY", "builtin": true },
        "daily": { "name": "Daily", "type": "search", "rule": "#recurrence *=* DAILY", "builtin": true },
        "weekly": { "name": "Weekly", "type": "search", "rule": "#recurrence *=* WEEKLY", "builtin": true },
        "monthly": { "name": "Monthly", "type": "search", "rule": "#recurrence *=* MONTHLY", "builtin": true },
        "yearly": { "name": "Yearly", "type": "search", "rule": "#recurrence *=* YEARLY", "builtin": true },
        "noRecurrence": { "name": "No Recurrence", "type": "search", "rule": "#!recurrence OR (#recurrence='')", "builtin": true },
        "1-career": { "name": "Career", "type": "search", "rule": "#area='01-career'", "builtin": true },
        "2-finances": { "name": "Finances", "type": "search", "rule": "#area='02-finances'", "builtin": true },
        "3-home": { "name": "Home", "type": "search", "rule": "#area='03-home'", "builtin": true },
        "4-car": { "name": "Car", "type": "search", "rule": "#area='04-car'", "builtin": true },
        "5-fitness": { "name": "Fitness", "type": "search", "rule": "#area='05-fitness'", "builtin": true },
        "6-grooming": { "name": "Grooming", "type": "search", "rule": "#area='06-grooming'", "builtin": true },
        "7-sexual": { "name": "Sexual", "type": "search", "rule": "#area='07-sexual'", "builtin": true },
        "8-social": { "name": "Social", "type": "search", "rule": "#area='08-social'", "builtin": true },
        "9-health": { "name": "Health", "type": "search", "rule": "#area='09-health'", "builtin": true },
        "10-mental": { "name": "Mental", "type": "search", "rule": "#area='10-mental'", "builtin": true },
        "11-identity": { "name": "Identity", "type": "search", "rule": "#area='11-identity'", "builtin": true },
        "12-productivity": { "name": "Productivity", "type": "search", "rule": "#area='12-productivity'", "builtin": true },
        "13-tech": { "name": "Tech", "type": "search", "rule": "#area='13-tech'", "builtin": true },
        "14-fun": { "name": "Fun", "type": "search", "rule": "#area='14-fun'", "builtin": true },
        "15-none": { "name": "No Area", "type": "search", "rule": "#!area OR #area=''", "builtin": true }
    },
    "sorts": {
        "startDate": { "name": "Start Date", "rule": "startDateTime", "builtin": true },
        "title": { "name": "Title", "rule": "title:caseInsensitive", "builtin": true },
        "typePriorityStartDate": { "name": "Type → Priority → Start Date", "rule": "type;priority:desc;startDateTime", "builtin": true },
        "typeStartDate": { "name": "Type → Start Date", "rule": "type;startDateTime", "builtin": true },
        "area": { "name": "Area → Start Date", "rule": "area;startDateTime", "builtin": true },
        "priorityStartDate": { "name": "Priority → Start Date", "rule": "priority:desc;startDateTime", "builtin": true },
        "priorityTypeStartDate": { "name": "Priority → Type → Start Date", "rule": "priority:desc;type;startDateTime", "builtin": true }
    },
    "prefixes": {
        "priority": {
            "name": "Priority",
            "type": "label",
            "label": "priority",
            "builtin": true,
            "children": { "4-critical": "Must Do", "3-high": "Should Do", "2-medium": "Could Do", "1-low": "Want to Do" }
        },
        "area": {
            "name": "Area",
            "type": "label",
            "label": "area",
            "builtin": true,
            "children": {
                "01-career": "Career", "02-finances": "Finances", "03-home": "Home", "04-car": "Car",
                "05-fitness": "Fitness", "06-grooming": "Grooming", "07-sexual": "Sexual", "08-social": "Social",
                "09-health": "Health", "10-mental": "Mental", "11-identity": "Identity", "12-productivity": "Productivity",
                "13-tech": "Tech", "14-fun": "Fun"
            }
        },
        "interval": {
            "name": "Interval",
            "type": "dayjs",
            "builtin": true,
            "intervals": {
                "overdue": { "dateRuleId": "overdue", "formatString": "MMM D, YYYY HH:mm" },
                "now": { "dateRuleId": "now", "formatString": "HH:mm" },
                "restOfDay": { "dateRuleId": "restOfDay", "formatString": "HH:mm" },
                "tomorrow": { "dateRuleId": "tomorrow", "formatString": "[Tmrw] HH:mm" },
                "thisWeek": { "dateRuleId": "thisWeek", "formatString": "ddd" },
                "thisMonth": { "dateRuleId": "thisMonth", "formatString": "Do" },
                "thisYear": { "dateRuleId": "thisYear", "formatString": "MMMM" },
                "future": { "dateRuleId": "future", "formatString": "YYYY" }
            }
        }
    },
    "colors": {
        "priority": {
            "name": "Priority",
            "type": "label",
            "label": "priority",
            "builtin": true,
            "children": { "4-critical": "red", "3-high": "gold", "2-medium": "lime", "1-low": "cyan" }
        },
        "area": {
            "name": "Area",
            "type": "label",
            "label": "area",
            "builtin": true,
            "children": {
                "01-career": "red", "02-finances": "red", "03-home": "darkorange", "04-car": "darkorange",
                "05-fitness": "gold", "06-grooming": "gold", "07-sexual": "gold", "08-social": "lime",
                "09-health": "lime", "10-mental": "lime", "11-identity": "lime", "12-productivity": "lime",
                "13-tech": "cyan", "14-fun": "magenta"
            }
        },
        "interval": {
            "name": "Interval",
            "type": "dayjs",
            "builtin": true,
            "intervals": {
                "overdue": { "dateRuleId": "overdue", "color": "red" },
                "now": { "dateRuleId": "now", "color": "lime" },
                "restOfDay": { "dateRuleId": "restOfDay", "color": "cyan" },
                "tomorrow": { "dateRuleId": "tomorrow", "color": "gray" },
                "thisWeek": { "dateRuleId": "thisWeek", "color": "lightgray" },
                "thisMonth": { "dateRuleId": "thisMonth", "color": "lightgray" },
                "thisYear": { "dateRuleId": "thisYear", "color": "lightgray" },
                "future": { "dateRuleId": "future", "color": "lightgray" }
            }
        }
    }
}
