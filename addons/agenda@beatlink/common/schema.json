            "prefixSelected": { "type": "reference", "label": "Prefix", "registry": "prefixes", "default": "" },
            "colorSelected": { "type": "reference", "label": "Color", "registry": "colors", "default": "" },
            "groupingSelected": { "type": "reference", "label": "Kanban Grouping", "registry": "groupings", "default": "" },
            "searchGroups": { "type": "checklist", "label": "Searches", "registry": "searchGroups", "filterBy": "profileId" },
