    "overviewNoteId": {
        "type": "note",
        "label": "Overview Note",
        "description": "The single shared collection note the active profile's matching tasks are filed under. Opening it shows the active profile's tasks in the chosen collection view.",
        "default": "",
        "tab": "Settings"
    },
    "activeProfileId": {
        "type": "reference",
        "registry": "profiles",
        "label": "Active Profile",
        "description": "Which profile currently populates the shared Overview Note. Switchable here or from the Agenda sidebar widget.",
        "default": "default",
        "tab": "Settings"
    },
    "myDayNoteId": {
        "type": "note",
        "label": "My Day Note",
        "description": "The note that shows the My Day focus controls (timer, mark done). The My Day widget only appears while browsing this note.",
        "default": "",
        "tab": "My Day"
    },
    "enableSounds": {
        "type": "boolean",
        "label": "Enable Timer Sounds",
        "default": true,
        "tab": "My Day"
    },
    "addTasksWhenDue": {
        "type": "boolean",
        "label": "Add Tasks When Due",
        "default": false,
        "tab": "My Day"
    },
    "sendDueNotifications": {
        "type": "boolean",
        "label": "Send Due Notifications",
        "default": true,
        "tab": "My Day"
    },
    "sectionState": {
        "type": "json",
        "hidden": true,
        "label": "Section State",
        "default": {}
    },
    "profiles": {
        "type": "registry",
        "label": "Profiles",
        "tab": "Profiles",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Profile" },
            "viewType": {
                "type": "select", "label": "Collection View", "default": "list",
                "options": [
                    { "value": "list", "label": "List" },
                    { "value": "grid", "label": "Grid" },
                    { "value": "table", "label": "Table" },
                    { "value": "board", "label": "Board" },
                    { "value": "calendar", "label": "Calendar" },
                    { "value": "geoMap", "label": "Geo Map" },
                    { "value": "dashboard", "label": "Dashboard" },
                    { "value": "presentation", "label": "Presentation" }
                ]
            },
            "sortSelected": { "type": "reference", "label": "Sort", "registry": "sorts", "default": "" },
            "prefixSelected": { "type": "reference", "label": "Prefix", "registry": "prefixes", "default": "" },
            "colorSelected": { "type": "reference", "label": "Color", "registry": "colors", "default": "" },
            "groupingSelected": { "type": "reference", "label": "Kanban Grouping", "registry": "groupings", "default": "" },
            "searchGroups": { "type": "checklist", "label": "Searches", "registry": "searchGroups", "filterBy": "profileId" },
            "filterGroups": { "type": "checklist", "label": "Filters", "registry": "filterGroups", "filterBy": "profileId" }
        },
        "default": {
            "default": {
                "name": "default",
                "viewType": "list",
                "sortSelected": "startDate",
                "prefixSelected": "interval",
                "colorSelected": "priority",
                "groupingSelected": "priority"
            }
        }
    },
    "searchGroups": {
        "type": "registry",
        "label": "Search Groups",
        "tab": "Searches",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Group" },
            "profileId": { "type": "reference", "label": "Profile", "registry": "profiles", "default": "" },
            "children": {
                "type": "registry",
                "label": "Searches",
                "default": {},
                "itemSchema": {
                    "name": { "type": "string", "label": "Name", "default": "New Search" },
                    "rule": { "type": "string", "label": "Search Rule", "default": "" },
                    "enabled": { "type": "boolean", "label": "Enabled", "default": true }
                }
            }
        },
        "default": {
            "type": {
                "name": "Note Type",
                "profileId": "default",
                "children": {
                    "all": { "name": "All Tasks", "rule": "(#startDateTime != \"\" OR #dueDateTime != \"\") AND not(note.parents.relations.template.title='3. Task')", "enabled": false },
                    "goal": { "name": "1. Goal", "rule": "~template.title='1. Goal' AND not(note.parents.relations.template.title='1. Goal') AND not(note.parents.relations.template.title='3. Task')", "enabled": true },
                    "routine": { "name": "2. Routines", "rule": "~template.title='2. Routine' AND not(note.parents.relations.template.title='2. Routine') AND not(note.parents.relations.template.title='3. Task')", "enabled": true },
                    "tasks": { "name": "3. Tasks", "rule": "~template.title='3. Task' AND not(note.parents.relations.template.title='3. Task')", "enabled": true },
                    "future": { "name": "4. Future", "rule": "~template.title='4. Future' AND not(note.parents.relations.template.title='4. Future') AND not(note.parents.relations.template.title='3. Task')", "enabled": true },
                    "project": { "name": "5. Projects", "rule": "~template.title='5. Project' AND not(note.parents.relations.template.title='5. Project') AND not(note.parents.relations.template.title='3. Task')", "enabled": true }
                }
            },
            "typeDated": {
                "name": "Note Type (Dated)",
                "profileId": "default",
                "children": {
                    "all": { "name": "All Tasks", "rule": "(#startDateTime != \"\" OR #dueDateTime != \"\") AND not(note.parents.relations.template.title='3. Task')", "enabled": false },
                    "goal": { "name": "1. Goal", "rule": "~template.title='1. Goal' AND not(note.parents.relations.template.title='1. Goal') AND not(note.parents.relations.template.title='3. Task') AND (#startDateTime != \"\" OR #dueDateTime != \"\")", "enabled": false },
                    "routine": { "name": "2. Routines", "rule": "~template.title='2. Routine' AND not(note.parents.relations.template.title='2. Routine') AND not(note.parents.relations.template.title='3. Task') AND (#startDateTime != \"\" OR #dueDateTime != \"\")", "enabled": false },
                    "tasks": { "name": "3. Tasks", "rule": "~template.title='3. Task' AND not(note.parents.relations.template.title='3. Task') AND (#startDateTime != \"\" OR #dueDateTime != \"\")", "enabled": false },
                    "future": { "name": "4. Future", "rule": "~template.title='4. Future' AND not(note.parents.relations.template.title='4. Future') AND not(note.parents.relations.template.title='3. Task') AND (#startDateTime != \"\" OR #dueDateTime != \"\")", "enabled": false },
                    "project": { "name": "5. Projects", "rule": "~template.title='5. Project' AND not(note.parents.relations.template.title='5. Project') AND not(note.parents.relations.template.title='3. Task') AND (#startDateTime != \"\" OR #dueDateTime != \"\")", "enabled": false }
                }
            }
        }
    },
    "filterGroups": {
        "type": "registry",
        "label": "Filter Groups",
        "tab": "Filters",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Filter Group" },
            "profileId": { "type": "reference", "label": "Profile", "registry": "profiles", "default": "" },
            "children": {
                "type": "registry",
                "label": "Filters",
                "default": {},
                "itemSchema": {
                    "name": { "type": "string", "label": "Name", "default": "New Filter" },
                    "type": {
                        "type": "select", "label": "Type", "default": "search",
                        "options": [
                            { "value": "search", "label": "Search Query" },
                            { "value": "dayjs", "label": "Date Comparison" }
                        ]
                    },
                    "rule": { "type": "string", "label": "Search Rule", "default": "", "showWhen": { "type": "search" } },
                    "dateRuleId": { "type": "reference", "label": "Date Rule", "registry": "dateRules", "default": "", "showWhen": { "type": "dayjs" } },
                    "enabled": { "type": "boolean", "label": "Enabled", "default": true }
                }
            }
        },
        "default": {
            "priority": {
                "name": "Priority",
                "profileId": "default",
                "children": {
                    "must": { "name": "Must Do", "type": "search", "rule": "#priority='4-critical'", "enabled": true },
                    "should": { "name": "Should Do", "type": "search", "rule": "#priority='3-high'", "enabled": true },
                    "could": { "name": "Could Do", "type": "search", "rule": "#priority='2-medium'", "enabled": true },
                    "want": { "name": "Want To Do", "type": "search", "rule": "#priority='1-low'", "enabled": true },
                    "none": { "name": "No Priority", "type": "search", "rule": "#!priority OR #priority=''", "enabled": false }
                }
            },
            "date": {
                "name": "Date",
                "profileId": "default",
                "children": {
                    "noDate": { "name": "No Date", "type": "dayjs", "dateRuleId": "noDate", "enabled": false },
                    "overdue": { "name": "Overdue", "type": "dayjs", "dateRuleId": "overdue", "enabled": true },
                    "now": { "name": "Now", "type": "dayjs", "dateRuleId": "now", "enabled": true },
                    "restOfDay": { "name": "Later Today", "type": "dayjs", "dateRuleId": "restOfDay", "enabled": true },
                    "tomorrow": { "name": "Tomorrow", "type": "dayjs", "dateRuleId": "tomorrow", "enabled": false },
                    "thisWeek": { "name": "This Week", "type": "dayjs", "dateRuleId": "thisWeek", "enabled": false },
                    "thisMonth": { "name": "This Month", "type": "dayjs", "dateRuleId": "thisMonth", "enabled": false },
                    "thisYear": { "name": "This Year", "type": "dayjs", "dateRuleId": "thisYear", "enabled": false },
                    "future": { "name": "Future", "type": "dayjs", "dateRuleId": "future", "enabled": false }
                }
            },
            "recurrence": {
                "name": "Recurrence",
                "profileId": "default",
                "children": {
                    "hourly": { "name": "Hourly", "type": "search", "rule": "#recurrence *=* HOURLY", "enabled": true },
                    "daily": { "name": "Daily", "type": "search", "rule": "#recurrence *=* DAILY", "enabled": true },
                    "weekly": { "name": "Weekly", "type": "search", "rule": "#recurrence *=* WEEKLY", "enabled": true },
                    "monthly": { "name": "Monthly", "type": "search", "rule": "#recurrence *=* MONTHLY", "enabled": true },
                    "yearly": { "name": "Yearly", "type": "search", "rule": "#recurrence *=* YEARLY", "enabled": true },
                    "noRecurrence": { "name": "No Recurrence", "type": "search", "rule": "#!recurrence OR (#recurrence='')", "enabled": true }
                }
            },
            "area": {
                "name": "Area",
                "profileId": "default",
                "children": {
                    "01-career": { "name": "Career", "type": "search", "rule": "#area='01-career'", "enabled": true },
                    "02-finances": { "name": "Finances", "type": "search", "rule": "#area='02-finances'", "enabled": true },
                    "03-legal": { "name": "Legal", "type": "search", "rule": "#area='03-legal'", "enabled": true },
                    "04-home": { "name": "Home", "type": "search", "rule": "#area='04-home'", "enabled": true },
                    "05-car": { "name": "Car", "type": "search", "rule": "#area='05-car'", "enabled": true },
                    "06-tech": { "name": "Tech", "type": "search", "rule": "#area='06-tech'", "enabled": true },
                    "07-fitness": { "name": "Fitness", "type": "search", "rule": "#area='07-fitness'", "enabled": true },
                    "08-grooming": { "name": "Grooming", "type": "search", "rule": "#area='08-grooming'", "enabled": true },
                    "09-sexual": { "name": "Sexual", "type": "search", "rule": "#area='09-sexual'", "enabled": true },
                    "10-social": { "name": "Social", "type": "search", "rule": "#area='10-social'", "enabled": true },
                    "11-mental": { "name": "Mental", "type": "search", "rule": "#area='11-mental'", "enabled": true },
                    "12-identity": { "name": "Identity", "type": "search", "rule": "#area='12-identity'", "enabled": true },
                    "13-fun": { "name": "Fun", "type": "search", "rule": "#area='13-fun'", "enabled": true },
                    "none": { "name": "No Area", "type": "search", "rule": "#!area OR #area=''", "enabled": true }
                }
            }
        }
    },
    "sorts": {
        "type": "registry",
        "label": "Sorts",
        "tab": "Sorts",
        "autosave": true,
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Sort" },
            "criteria": {
                "type": "list",
                "label": "Criteria",
                "default": [],
                "itemSchema": {
                    "attribute": { "type": "string", "label": "Attribute", "default": "" },
                    "desc": { "type": "boolean", "label": "Descending", "default": false },
                    "caseInsensitive": { "type": "boolean", "label": "Case Insensitive", "default": false }
                }
            }
        },
        "default": {
            "startDate": { "name": "Start Date", "criteria": [
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "title": { "name": "Title", "criteria": [
                { "attribute": "title", "desc": false, "caseInsensitive": true }
            ] },
            "typePriorityStartDate": { "name": "Type → Priority → Start Date", "criteria": [
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "typeStartDate": { "name": "Type → Start Date", "criteria": [
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "area": { "name": "Area → Start Date", "criteria": [
                { "attribute": "area", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "priorityStartDate": { "name": "Priority → Start Date", "criteria": [
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] },
            "priorityTypeStartDate": { "name": "Priority → Type → Start Date", "criteria": [
                { "attribute": "priority", "desc": true, "caseInsensitive": false },
                { "attribute": "type", "desc": false, "caseInsensitive": false },
                { "attribute": "startDateTime", "desc": false, "caseInsensitive": false }
            ] }
        }
    },
    "prefixes": {
