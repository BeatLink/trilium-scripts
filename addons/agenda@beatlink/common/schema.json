    "rescheduleOptions": {
        "type": "registry",
        "hidden": true,
        "label": "Reschedule Options",
        "description": "The choices offered by the Task pane's Reschedule dropdown. Each is either a fixed number of days from now, or the next occurrence of a recurrence rule computed from now. Order here is dropdown order. Edited via the custom Reschedule Options panel (rescheduleOptions.jsx), not the generic form — a recurrence rule needs the real RecurrencePicker UI, not a raw rrule text box.",
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Option" },
            "mode": {
                "type": "select", "label": "Mode", "default": "days",
                "options": [
                    { "value": "days", "label": "Days From Now" },
                    { "value": "recurrence", "label": "Recurrence Rule" }
                ]
            },
            "days": { "type": "number", "label": "Days From Now", "default": 0, "showWhen": { "mode": "days" } },
            "recurrence": { "type": "string", "label": "Recurrence Rule", "default": "", "showWhen": { "mode": "recurrence" } }
        },
        "default": {
            "today": { "name": "Today", "mode": "days", "days": 0 },
            "tomorrow": { "name": "Tomorrow", "mode": "days", "days": 1 }
        }
    },
    "dimensions": {
        "type": "registry",
        "label": "Dimensions",
        "description": "The classification axes notes are tagged with. Each dimension is one note label plus its ordered vocabulary of values. Adding a dimension here gives you a triage queue in Organize, a sort ordinal, and a derived prefix/color/grouping/filter variant, with no code change. Value order is this list's order, so reordering never rewrites a tagged note.",
        "category": "Dimensions",
        "tab": "Dimensions",
        "itemSchema": {
            "name": { "type": "string", "label": "Name", "default": "New Dimension" },
            "label": { "type": "string", "label": "Note Label", "description": "The note label values are written to, without the leading #.", "default": "" },
            "writeColor": { "type": "boolean", "label": "Also Write #color", "description": "Mirror the chosen value's colour onto the note's #color label, tinting it in the tree.", "default": false },
            "triage": { "type": "boolean", "label": "Triage Unassigned Notes", "description": "Give this dimension a queue in Organize listing notes that lack a value.", "default": true },
            "actionableOnly": { "type": "boolean", "label": "Triage Only Actionable Notes", "description": "Restrict that queue to notes whose type is marked Actionable.", "default": false },
            "scaffoldsAreas": { "type": "boolean", "label": "Scaffold A Root Note Per Value", "description": "Workflow Setup builds one notebook root note per value of this dimension.", "default": false },
            "values": {
                "type": "registry",
                "label": "Values",
                "default": {},
                "itemSchema": {
                    "name": { "type": "string", "label": "Name", "default": "" },
                    "key": { "type": "string", "label": "Label Value", "description": "The stored value. Changing it orphans every note already tagged with the old one.", "default": "" },
                    "color": { "type": "color", "label": "Color", "default": "gray" },
                    "actionable": { "type": "boolean", "label": "Actionable", "description": "Items of this value flow through the priority and start-date triage queues.", "default": false },
                    "icon": { "type": "string", "label": "Bucket Icon", "default": "" }
                }
            }
        },
        "default": {
            "area": {
                "name": "Area",
                "label": "area",
                "writeColor": true,
                "triage": true,
                "actionableOnly": false,
                "scaffoldsAreas": true,
                "values": {
                    "career": { "name": "Career", "key": "career", "color": "red" },
                    "finances": { "name": "Finances", "key": "finances", "color": "red" },
                    "legal": { "name": "Legal", "key": "legal", "color": "red" },
                    "home": { "name": "Home", "key": "home", "color": "darkorange" },
                    "car": { "name": "Car", "key": "car", "color": "darkorange" },
                    "tech": { "name": "Tech", "key": "tech", "color": "darkorange" },
                    "fitness": { "name": "Fitness", "key": "fitness", "color": "gold" },
                    "grooming": { "name": "Grooming", "key": "grooming", "color": "gold" },
                    "sexual": { "name": "Sexual", "key": "sexual", "color": "gold" },
                    "social": { "name": "Social", "key": "social", "color": "lime" },
                    "mental": { "name": "Mental", "key": "mental", "color": "lime" },
                    "identity": { "name": "Identity", "key": "identity", "color": "lime" },
                    "fun": { "name": "Fun", "key": "fun", "color": "magenta" }
                }
            },
            "priority": {
                "name": "Priority",
                "label": "priority",
                "writeColor": true,
                "triage": true,
                "actionableOnly": true,
                "scaffoldsAreas": false,
                "values": {
                    "4-critical": { "name": "Must Do", "key": "4-critical", "color": "red" },
                    "3-high": { "name": "Should Do", "key": "3-high", "color": "gold" },
                    "2-medium": { "name": "Could Do", "key": "2-medium", "color": "lime" },
                    "1-low": { "name": "Want to Do", "key": "1-low", "color": "cyan" }
                }
            }
        }
    },
    "profiles": {
        "type": "registry",
        "label": "Profiles",
