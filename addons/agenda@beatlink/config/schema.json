{
    "_categories": [
        "Review",
        "Display Elements",
        "Dimensions",
        "Settings"
    ],
    "startDatetimeLabel": {
        "type": "string",
        "label": "Start Datetime Label",
        "description": "The note label holding a task's start datetime. Read for the overview's Start column, the iCal feed and due notifications. agenda-task@beatlink and agenda-myday@beatlink each carry their own copy of this setting; rename it in one and rename it in the others too.",
        "category": "Settings",
        "tab": "Settings"
    },
    "dueDatetimeLabel": {
        "type": "string",
        "label": "Due Datetime Label",
        "description": "The note label holding a task's due datetime. Read for the overview's Due column and the iCal feed.",
        "category": "Settings",
        "tab": "Settings"
    },
    "recurrenceLabel": {
        "type": "string",
        "label": "Recurrence Label",
        "description": "The note label holding a task's recurrence rule. Read for the iCal feed and for grouping/filtering by recurrence frequency.",
        "category": "Settings",
        "tab": "Settings"
    },
    "overviewNoteId": {
        "type": "note",
        "label": "Overview Note",
        "description": "The single shared collection note the active profile's matching tasks are filed under. Opening it shows the active profile's tasks in the chosen collection view.",
        "category": "Review",
        "tab": "Overview"
    },
    "activeProfileId": {
        "type": "reference",
        "registry": "profiles",
        "label": "Active Profile",
        "description": "Which profile currently populates the shared Overview Note. Switchable here or from the Agenda sidebar widget.",
        "category": "Review",
        "tab": "Active Profile"
    },
    "sectionState": {
        "type": "json",
        "hidden": true,
        "label": "Section State"
    },
    "dimensions": {
        "type": "registry",
        "label": "Dimensions",
        "description": "The classification axes notes are tagged with. Each dimension is one note label plus its ordered vocabulary of values. Adding a dimension here gives you a triage queue in Organize, a sort ordinal, and a derived prefix/color/grouping/filter variant, with no code change. Value order is this list's order, so reordering never rewrites a tagged note.",
        "category": "Dimensions",
        "tab": "Dimensions",
        "itemSchema": {
            "name": {
                "type": "string",
                "label": "Name",
                "default": "New Dimension"
            },
            "label": {
                "type": "string",
                "label": "Note Label",
                "description": "The note label values are written to, without the leading #.",
                "default": ""
            },
            "writeColor": {
                "type": "boolean",
                "label": "Also Write #color",
                "description": "Mirror the chosen value's colour onto the note's #color label, tinting it in the tree.",
                "default": false
            },
            "triage": {
                "type": "boolean",
                "label": "Triage Unassigned Notes",
                "description": "Give this dimension a queue in Organize listing notes that lack a value.",
                "default": true
            },
            "actionableOnly": {
                "type": "boolean",
                "label": "Triage Only Actionable Notes",
                "description": "Restrict that queue to notes whose type is marked Actionable.",
                "default": false
            },
            "scaffoldsAreas": {
                "type": "boolean",
                "label": "Scaffold A Root Note Per Value",
                "description": "This dimension is the one whose values each get a notebook root note.",
                "default": false
            },
            "values": {
                "type": "registry",
                "label": "Values",
                "default": {},
                "itemSchema": {
                    "name": {
                        "type": "string",
                        "label": "Name",
                        "default": ""
                    },
                    "key": {
                        "type": "string",
                        "label": "Label Value",
                        "description": "The stored value. Changing it orphans every note already tagged with the old one.",
                        "default": ""
                    },
                    "color": {
                        "type": "color",
                        "label": "Color",
                        "default": "gray"
                    },
                    "actionable": {
                        "type": "boolean",
                        "label": "Actionable",
                        "description": "Items of this value flow through the priority and start-date triage queues.",
                        "default": false
                    },
                    "icon": {
                        "type": "string",
                        "label": "Bucket Icon",
                        "default": ""
                    }
                }
            }
        }
    },
